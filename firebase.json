{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "scripts/**",
      "www/**",
      "*.apk",
      "**/*.apk",
      "**/*.exe",
      "**/*.bat",
      "**/*.cmd",
      "**/*.sh",
      "**/*.jar"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
